rules_version = '2';

// Broast Al Bahr — Storage rules · Phase 2 (auth-required).
// Product images uploaded by admin (owner or branch manager). Reads are
// public so customers see photos without an Auth round-trip.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['owner', 'branch'];
    }

    match /items/{imageId} {
      allow read: if true;
      allow write: if isStaff()
                   && (request.resource == null
                       || (request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
