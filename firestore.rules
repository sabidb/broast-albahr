rules_version = '2';

// Broast Al Bahr — Firestore rules.
//
// PHASE 1 STATE: the customer app has no Firebase Auth yet, so menu, restaurant
// settings, orders, customers, counters, notifications and (read-only) branches
// are open to the client. Phase 2 rewrites every match block to require
// `request.auth` + custom claims (role/branchId). Do NOT relax anything here.
//
// This file must stay in sync with:
//   sabidb/Al-bahr-admin/firestore.rules
// Both repos share one Firebase project (broast-al-bahr) — the deployed rule
// set is whichever repo was pushed last.

service cloud.firestore {
  match /databases/{database}/documents {

    // Live menu, restaurant open/closed, announcement banner, invoice/printer
    // config, coupons config. Read by customers, written by admin (Phase 2:
    // writes will require role in ['owner','branch']).
    match /settings/{doc} {
      allow read, write: if true;
    }

    // Orders placed by customers. Customer app also reads them back for history.
    // Phase 2: create by authenticated customers only, mutate by staff only.
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customer loyalty profiles keyed by phone. Phase 2: keyed by Auth uid.
    match /customers/{phone} {
      allow read, write: if true;
    }

    // Per-branch atomic order-number counters (orderNo-{branchId}).
    // MUST be readable/writable or the transaction falls back to a local counter.
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Customer inbox notifications (subcollection under phone).
    match /notifications/{phone}/items/{itemId} {
      allow read, write: if true;
    }

    // Branches — public read for customer branch picker, writes will be
    // owner-only (Phase 4). Left open in Phase 1 so the admin app's existing
    // branch CRUD keeps working with no rule change.
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // Staff role profiles (email, role, branchId). Loaded by the admin app
    // right after Firebase Auth sign-in, so authenticated reads are required.
    // Writes remain locked to the owner via the admin UI + Auth account level.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
