rules_version = '2';

// Broast Al Bahr — Firestore rules · Phase 2 (auth-required).
//
// Customer app authenticates via Firebase Phone Auth. Every customer path is
// keyed by phone number and validated against `request.auth.token.phone_number`.
// Admin app authenticates via email/password; roles live in `users/{uid}` and
// are read at rule time (custom claims land in Wave 2 once Blaze is enabled).
//
// This file must stay in sync with sabidb/Al-bahr-admin/firestore.rules.
// Both apps share one Firebase project (broast-al-bahr).

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    // Auth model: customers get an anonymous Firebase Auth uid on first
    // visit; customers/{uid} carries their name + phone as profile data.
    // Staff (owner + branch managers) use email/password Auth; their role
    // profile lives in users/{uid}.

    function signedIn() { return request.auth != null; }

    function ownsCustomer(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Notifications are still keyed by phone (admin knows the phone from
    // the order). Verify the caller's customer profile carries that phone.
    function callerPhoneIs(phone) {
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid))
        && get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.get('phone', '') == phone;
    }

    // The phone the caller declared on their customer profile. Trusted at the
    // "customer's own history" level only — real phone verification lands in
    // Phase 10. Empty string if no customer doc yet (blocks the rule below).
    function callerPhone() {
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.get('phone', '')
        : '';
    }

    function isStaff() {
      // Owner + branch manager both count as staff. Read the role from users/{uid}.
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'branch'];
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function staffBranch() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('branchId', '')
        : '';
    }

    function isBranchStaff(branchId) {
      return isOwner() || (isStaff() && staffBranch() == branchId);
    }

    // ── collections ──────────────────────────────────────────────────────

    // Live menu, restaurant open/closed, announcement, per-branch invoice/printer
    // configs, coupons config. PUBLIC READ so the customer can see the menu
    // before signing in (menu is public info; browsers hit this on first load).
    // Owner-only write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Branches — PUBLIC READ for the customer branch picker (shown before
    // sign-in). Owner creates/deletes/renames; branch manager can edit only
    // their own branch's mutable fields (hours, phone, address, active flag).
    match /branches/{branchId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isBranchStaff(branchId);
    }

    // Customer profiles keyed by Firebase Auth uid (anonymous). Owning
    // customer OR any staff may write. Read also allowed when the doc's
    // phone equals the caller's declared phone — a re-installed customer
    // needs to see sibling docs on the same phone to aggregate their
    // loyalty points (Phase 10 will merge sibling docs server-side).
    match /customers/{uid} {
      allow read: if ownsCustomer(uid)
        || (callerPhone() != '' && resource.data.get('phone', '') == callerPhone())
        || isStaff();
      allow write: if ownsCustomer(uid) || isStaff();
    }

    // Orders: customers create their own (userUid must match caller);
    // customers read only their own; staff read/write scoped by branch.
    match /orders/{orderId} {
      // Phase 3 shape checks — same guarantees the client-side validateOrder()
      // enforces, mirrored server-side so a bypassed client can't sneak a
      // malformed doc past. Keeps out empty items[], missing userPhone/orderNo,
      // wrong types on totals — all preconditions the admin panel relies on.
      allow create: if signedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.branch is string
        && request.resource.data.branch.size() > 0
        && request.resource.data.userPhone is string
        && request.resource.data.userPhone.matches('^05\\d{8}$')
        && request.resource.data.userName is string
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.matches('^\\d{6}$')
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.totals is map;
      // Read is allowed for the owning uid, the owning phone (so history
      // survives re-installs / new devices when the user re-enters their
      // number), or branch-scoped staff.
      allow read: if (signedIn() && resource.data.get('userUid', '') == request.auth.uid)
        || (callerPhone() != '' && resource.data.get('userPhone', '') == callerPhone())
        || isBranchStaff(resource.data.branch);
      // Rating: the owning customer may attach a rating; everything else is staff-only.
      allow update: if isBranchStaff(resource.data.branch)
        || (signedIn()
            && resource.data.get('userUid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating']));
      allow delete: if isOwner();
    }

    // Per-branch atomic order-number counters (orderNo-{branchId}).
    // Any signed-in customer needs read+write during checkout transaction.
    // Phase 6 moves order creation server-side and locks these to functions.
    match /counters/{counterId} {
      allow read, write: if signedIn();
    }

    // Coupons catalog: PUBLIC READ (codes are already embedded in the customer
    // bundle; Phase 10 moves redemption server-side and locks per-customer
    // limits there). Owner writes.
    match /coupons/{code} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Customer inbox notifications — still keyed by phone (admin sends
    // by phone from an order). Verify the caller's customer profile
    // carries that phone.
    match /notifications/{phone}/items/{itemId} {
      allow read, update: if callerPhoneIs(phone) || isStaff();
      allow create: if isStaff();
      allow delete: if isOwner();
    }

    // Staff role profiles. Any signed-in admin reads the roster (needed to
    // render "Staff Management"). Owner-only writes so a branch manager can't
    // promote themselves.
    match /users/{uid} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // Everything else denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
